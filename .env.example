# App
PORT=3000
# Local dev default. On Railway, APP_URL is optional — server auto-uses RAILWAY_PUBLIC_DOMAIN
# when APP_URL is unset or still localhost (see docs/RAILWAY_SETUP.md).
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
DEMO_AUTH=true
# Soft-launch mode: landing + waitlist only (blocks /dashboard, /terminal, demo auth, OAuth).
# TradeSimple is open by default — leave LANDING_ONLY unset/false unless you're
# deliberately doing a scarcity-gated soft launch.
# LANDING_ONLY=true
# DEMO_AUTH=false

# Data accuracy: production | strict | live = require Congress + Finnhub + LDA (no seed lobbying dollars)
# demo | development | off = allow scenario fallbacks when API keys are missing
DATA_ACCURACY_MODE=production

# Feature gates: week1 (default) | beta-extended | full-feature
# full-feature enables Lobbying, Analysis Lab, AI Research, Settings, Alerts, Track Record, Crypto, etc.
LAUNCH_PHASE=full-feature

# Dev-preview passcode: set this and a "Preview access" link appears in the landing
# page footer. Entering the correct passcode there bypasses LANDING_ONLY for that
# browser only (signed cookie, ~30 days) so you (or anyone you give the code to) can
# reach the terminal/ledger before public launch, without exposing them to everyone.
# Leave unset to hide the link entirely.
# PREVIEW_PASSCODE=

# Google OAuth
# Redirect URI: http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
# Redirect URI: http://localhost:3000/auth/callback/apple
# APPLE_CLIENT_SECRET is the Apple client-secret JWT you generate from your Apple team/key.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Market data
FINNHUB_API_KEY=
# Finnhub free tier (~60 req/min) — pace all quote/profile/candle calls globally
FINNHUB_MIN_INTERVAL_MS=2000
FINNHUB_COOLDOWN_MS=105000
QUOTE_FETCH_CONCURRENCY=1
CATALOG_WARM_INTERVAL_MS=5000
QUOTE_FRESH_SKIP_MS=120000
QUOTE_CACHE_TTL_MS=60000

# yfinance Python sidecar (fallback / enrichment when Finnhub fails or is unset)
# Primary quotes still use Finnhub when FINNHUB_API_KEY is set.
YFINANCE_ENABLED=true
# Uses .venv-yfinance/bin/python3 automatically when present (see README)
# YFINANCE_PYTHON=python3
# Optional: explicit venv path — overrides auto-detect
# YFINANCE_VENV=/absolute/path/to/TradeSimple v1/.venv-yfinance
# Optional: prepend to PYTHONPATH (local yfinance clone or site-packages)
# YFINANCE_PYTHONPATH=/Users/you/Downloads/yfinance-main
# YFINANCE_LOCAL_PATH=/Users/you/Downloads/yfinance-main
# YFINANCE_BRIDGE_TIMEOUT_MS=12000

# Public AI routes (rate limited per IP)
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
SCORECARD_CACHE_TTL_MS=300000
COINGECKO_API_KEY=
COINGECKO_PRO=false

# Legislative data (required for arbitrary bill briefs; without Congress key only curated seed bills work)
CONGRESS_API_KEY=
SENATE_LDA_API_KEY=
# FEC Open API — campaign finance pulse & bill money context (api.open.fec.gov)
FEC_API_KEY=
# Pulse cache + background refresh (ms). Default 8m — use 300000–600000 for 5–10m cadence.
# FEC_PULSE_CACHE_TTL_MS=480000
# FEC_REFRESH_MS=480000
# Background refresh intervals (ms)
CONGRESS_REFRESH_MS=900000
CONGRESS_CACHE_TTL_MS=3600000
AD_HOC_CONGRESS_TTL_MS=900000
USASPENDING_CACHE_TTL_MS=900000
QUOTE_REFRESH_MS=60000
LDA_REFRESH_MS=3600000

# Supabase (Tradesimpledev project — run supabase/schema.sql in SQL editor first)
# Server-side only: use service_role key, never the anon/publishable key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Railway soft-launch checklist (paste into Railway → Variables) ──
# APP_URL=https://YOUR-SERVICE.up.railway.app     # optional on Railway (RAILWAY_PUBLIC_DOMAIN fallback)
# RESEND_API_KEY=re_...                           # welcome email + founder signup alerts (resend.com)
# DISPATCH_NOTIFY_EMAIL=founder@yourdomain.com    # inbox for new dispatch signups
# SENATE_LDA_API_KEY=...                          # live lobbying overlays on bill briefs (lda.senate.gov)
# GET /api/config → dispatch.dispatchWelcomeEnabled, dispatch.ldaEnabled (booleans, no secrets)

# Dispatch / waitlist notifications (optional — Resend via native fetch, no npm deps)
# Sign up at resend.com, verify a sending domain (or use onboarding@resend.dev for testing).
RESEND_API_KEY=
DISPATCH_NOTIFY_EMAIL=you@example.com
# Optional — defaults to TradeSimple Dispatch <onboarding@resend.dev> for Resend sandbox
# DISPATCH_FROM_EMAIL=TradeSimple <dispatch@yourdomain.com>
# Editorial lead bill linked in dispatch welcome emails (default S.2-119)
# EDITORIAL_LEAD_BILL_ID=S.2-119
# Protects /api/admin/waitlist and POST /api/admin/trending (x-admin-secret header)
ADMIN_SECRET=

# Broker / paper trading
# Paper endpoint is used by default. Live trading requires ALLOW_LIVE_TRADING=true.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# Route paper orders to Alpaca when keys are set (still mirrors local paper account for UI)
ALPACA_PAPER_ENABLED=false
ALLOW_LIVE_TRADING=false

# Optional AI research route (plain-English bill/contract brief summaries on share pages; cached 24h)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
BRIEF_AI_RATE_LIMIT_MAX=10
BRIEF_AI_RATE_LIMIT_WINDOW_MS=3600000
BRIEF_SUMMARY_TTL_MS=86400000

# Social pulse (honest, gated — no fabricated tweets)
# Curated public-figure links are always available. Set SOCIAL_RSS_URL to an RSS/Atom feed you control for "Live feed" items.
# SOCIAL_RSS_URL=
# SOCIAL_RSS_FETCH_MS=8000
# SOCIAL_RSS_CACHE_TTL_MS=300000

# SEC EDGAR (public API; SEC requires a descriptive User-Agent)
SEC_USER_AGENT="TradeSimple/1.0 (your-email@example.com)"
