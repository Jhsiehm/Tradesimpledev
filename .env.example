# App
PORT=3000
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-string
DEMO_AUTH=true

# Data accuracy: production | strict | live = require Congress + Finnhub + LDA (no seed lobbying dollars)
# demo | development | off = allow scenario fallbacks when API keys are missing
DATA_ACCURACY_MODE=production

# Google OAuth
# Redirect URI: http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
# Redirect URI: http://localhost:3000/auth/callback/apple
# APPLE_CLIENT_SECRET is the Apple client-secret JWT you generate from your Apple team/key.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Market data
FINNHUB_API_KEY=
QUOTE_CACHE_TTL_MS=15000

# yfinance Python sidecar (fallback / enrichment when Finnhub fails or is unset)
# Primary quotes still use Finnhub when FINNHUB_API_KEY is set.
YFINANCE_ENABLED=true
# Uses .venv-yfinance/bin/python3 automatically when present (see README)
# YFINANCE_PYTHON=python3
# Optional: explicit venv path — overrides auto-detect
# YFINANCE_VENV=/absolute/path/to/TradeSimple v1/.venv-yfinance
# Optional: prepend to PYTHONPATH (local yfinance clone or site-packages)
# YFINANCE_PYTHONPATH=/Users/you/Downloads/yfinance-main
# YFINANCE_LOCAL_PATH=/Users/you/Downloads/yfinance-main
# YFINANCE_BRIDGE_TIMEOUT_MS=12000

# Public AI routes (rate limited per IP)
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=60000
SCORECARD_CACHE_TTL_MS=300000
COINGECKO_API_KEY=
COINGECKO_PRO=false

# Legislative data (required for arbitrary bill briefs; without Congress key only curated seed bills work)
CONGRESS_API_KEY=
SENATE_LDA_API_KEY=
# Background refresh intervals (ms)
CONGRESS_REFRESH_MS=900000
CONGRESS_CACHE_TTL_MS=3600000
AD_HOC_CONGRESS_TTL_MS=900000
USASPENDING_CACHE_TTL_MS=900000
QUOTE_REFRESH_MS=60000
LDA_REFRESH_MS=3600000

# Supabase (Tradesimpledev project — run supabase/schema.sql in SQL editor first)
# Server-side only: use service_role key, never the anon/publishable key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Broker / paper trading
# Paper endpoint is used by default. Live trading requires ALLOW_LIVE_TRADING=true.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
# Route paper orders to Alpaca when keys are set (still mirrors local paper account for UI)
ALPACA_PAPER_ENABLED=false
ALLOW_LIVE_TRADING=false

# Optional AI research route (plain-English bill/contract brief summaries on share pages; cached 24h)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
BRIEF_AI_RATE_LIMIT_MAX=10
BRIEF_AI_RATE_LIMIT_WINDOW_MS=3600000
BRIEF_SUMMARY_TTL_MS=86400000

# Social pulse (honest, gated — no fabricated tweets)
# Curated public-figure links are always available. Set SOCIAL_RSS_URL to an RSS/Atom feed you control for "Live feed" items.
# SOCIAL_RSS_URL=
# SOCIAL_RSS_FETCH_MS=8000
# SOCIAL_RSS_CACHE_TTL_MS=300000

# SEC EDGAR (public API; SEC requires a descriptive User-Agent)
SEC_USER_AGENT="TradeSimple/1.0 (your-email@example.com)"
